@model COFFEE_SHOP.Models.Product

<div class="col-12 col-md-6 col-lg-4 item features-image">
    <div class="item-wrapper">
        <div class="item-img">
            <img src="@Model.ImageUrl" alt="@Model.Name" />
        </div>
        <div class="item-content">
            <a asp-controller="Product" asp-action="Detail" asp-route-id="@Model.Id" target="_self">
                <h6 class="item-subtitle mbr-fonts-style mt-1 display-7">
                    <strong>@Model.Name</strong>
                </h6>
            </a>
            <p class="mbr-text mbr-fonts-style mt-3 display-7">@Model.Price.ToString("C")</p>
        </div>
        <div class="mbr-section-btn item-footer mt-2">
            <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-id="@Model.Id" class="btn item-btn btn-primary display-4" target="_self">
                <span class="mbrib-cart-add mbr-iconfont mbr-iconfont-btn"></span>Add to cart
            </a>
        </div>
    </div>
</div>