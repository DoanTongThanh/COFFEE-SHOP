@model COFFEE_SHOP.Models.Product

@if (ViewBag.SessionInfo != null)
{
    <div class="alert alert-info py-2 my-2">
        🛒 <strong>Trạng thái Session:</strong> @ViewBag.SessionInfo
    </div>
}

@if (ViewBag.SessionProduct != null)
{
    var sProduct = ViewBag.SessionProduct as COFFEE_SHOP.Models.Product;
    <div class="alert alert-success p-3 my-3">
        <h5>🎉 <strong>Sản phẩm vừa được lưu vào Session Object:</strong></h5>
        <p class="mb-1"><strong>Tên:</strong> @sProduct.Name</p>
        <p class="mb-0"><strong>Giá:</strong> @sProduct.Price.ToString("c")</p>
    </div>
}

@{
    ViewData["Title"] = "Chi Tiết Sản Phẩm";
}

<br />
<div class="container">
    <div class="card-wrapper">
        <div class="row align-items-center">
            <div class="col-12 col-lg-6">
                <div class="image-wrapper">
                    <img src="@Model.ImageUrl" alt="Website Builder" />
                </div>
            </div>
            
            <div class="col-12 col-lg">
                <div class="text-box">
                    <h5 class="mbr-title mbr-fonts-style display-2">
                        <strong>@Model.Name</strong>
                    </h5>
                    
                    <p class="mbr-text mbr-fonts-style display-7">
                        @Model.Detail
                    </p>
                    
                    <div class="cost">
                        <span class="currentcost mbr-fonts-style pr-2 display-2">
                            $@Model.Price.ToString("0.00")
                        </span>
                    </div>
                    
                    <div class="mbr-section-btn pt-3">
                        <a href="" class="btn btn-primary display-4">
                            <span class="mbrib-cart-add mbr-iconfont mbr-iconfont-btn"></span>Add to cart&nbsp;
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<br />