<!DOCTYPE html> 
<html> 
<head> 
<title>Coffee Shop</title> 
</head> 
<body> 
<h1>Shop Coffee</h1> 
@foreach (var item in Model) 
{ 
<img width="100" src="@item.ImageUrl" /> 
<h3>@item.Name</h3> 
<p>@item.Price.ToString("C")</p> 
} 
</body> 
</html>

@model IEnumerable<COFFEE_SHOP.Models.Product>

@{
    ViewData["Title"] = "Cửa Hàng Cà Phê";
}

<div class="container mt-5">
    <h1 class="text-center mb-4 text-success fw-bold">MENU COFFEE SHOP</h1>
    <p class="text-center text-muted mb-5">Thưởng thức hương vị cà phê đậm đà từ khắp nơi trên thế giới</p>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 220px; object-fit: cover;">
                    
                    <div class="card-body d-flex flex-column">
                        
                        <h5 class="card-title fw-bold text-dark">@product.Name</h5>
                        
                        
                        <p class="card-text text-secondary flex-grow-1">@product.Detail</p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            
                            <span class="text-danger fw-bold fs-5">$@product.Price.ToString("0.00")</span>
                            
                            
                            <button class="btn btn-outline-success btn-sm px-3 rounded-pill">Thêm vào giỏ</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>